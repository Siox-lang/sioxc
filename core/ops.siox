module core::ops;

// The hooks expression syntax dispatches to (proposals/core-std.md), as
// rustc's `core::ops`: operators, literal affixes, indexing and ranges, plus
// the hooks rustc has no counterpart for: conditions (`Boolean`),
// parallel-driver resolution (`Resolve`) and packed logic (`LogicEncoding`).
// `std::ops` re-exports them.

use core::primitive::Bool;

// Operators, as rustc's (spec 3.25). The standard operators are named
// traits, each with a method named after it; overloads select by the right
// operand's type (`Rhs`), and `Out` names the result type. Their precedence
// is the grammar's. Comparisons are `core::cmp`'s `Eq` and `Ord`.
pub trait Add<Rhs, Out> { fn add(self, rhs: Rhs) -> Out; }   // a + b
pub trait Sub<Rhs, Out> { fn sub(self, rhs: Rhs) -> Out; }   // a - b
pub trait Mul<Rhs, Out> { fn mul(self, rhs: Rhs) -> Out; }   // a * b
pub trait Div<Rhs, Out> { fn div(self, rhs: Rhs) -> Out; }   // a / b
pub trait Shl<Rhs, Out> { fn shl(self, rhs: Rhs) -> Out; }   // a << b
pub trait Shr<Rhs, Out> { fn shr(self, rhs: Rhs) -> Out; }   // a >> b
// `and`/`or`/`not` are one boolean-per-bit family, not rustc's bitwise and
// logical pair, so the traits take the operators' own names.
pub trait And<Rhs, Out> { fn and(self, rhs: Rhs) -> Out; }   // a and b
pub trait Or<Rhs, Out> { fn or(self, rhs: Rhs) -> Out; }     // a or b
pub trait Not<Out> { fn not(self) -> Out; }                  // not a

// A user operator: any symbol or word the grammar does not reserve, such as
// `xor`. It binds its precedence inside its impl with `attr precedence = N;`.
pub trait CustomOperator<op: string, Rhs, Out> {
    fn apply(self, rhs: Rhs) -> Out;
}

// Literal affixes are symbol-parameterized the same way (spec 3.24): the first
// argument is the affix string, the second the literal's data type.
//   - a bit-string prefix `x"AB"` dispatches to `impl Prefix<"x", string> for T`
//   - a numeric suffix `10ns` dispatches to `impl Suffix<"ns", integer> for T`
// The impl's target type is what the literal produces; prefix evaluation is a
// compiler intrinsic (radix expansion) until const string operations land, so
// prefix impls inherit the empty default body.
pub trait Prefix<char: string, T> {
    fn prefix(data: T) {}
}

pub trait Suffix<char: string, T> {
    fn suffix(data: T) {}
}

// Inclusive index ranges are ordinary values when indexing is overloaded.
// Partial source forms (`..right`, `left..`, `..`) are completed from the indexed
// object's declared bounds before dispatch.
pub struct Range {
    pub left: integer,
    pub right: integer
}

// `value[index]` falls back to Index when `value` is not an intrinsic packed
// vector or array. `value[index] = next` similarly uses IndexAssign.
pub trait Index<I, Output> {
    fn index(self, index: I) -> Output;
}

pub trait IndexAssign<I, Value> {
    fn index_assign(self, index: I, value: Value);
}

// `and`/`or` have one type-directed meaning. For Bool-like operands they are
// scalar boolean logic; for bit-derived operands they apply per bit.
impl And<Bool, Bool> for Bool {
    fn and(self, rhs: Bool) -> Bool {
        if self {
            return rhs;
        }
        return false;
    }
}

impl Or<Bool, Bool> for Bool {
    fn or(self, rhs: Bool) -> Bool {
        if self { return true; }
        return rhs;
    }
}

impl Not<Bool> for Bool {
    fn not(self) -> Bool {
        if self { return false; }
        return true;
    }
}

impl CustomOperator<"xor", Bool, Bool> for Bool {
    attr precedence = 35;
    fn apply(self, rhs: Bool) -> Bool {
        if self { return not rhs; }
        return rhs;
    }
}

impl CustomOperator<"nand", Bool, Bool> for Bool {
    attr precedence = 40;
    fn apply(self, rhs: Bool) -> Bool { return not (self and rhs); }
}

impl CustomOperator<"nor", Bool, Bool> for Bool {
    attr precedence = 30;
    fn apply(self, rhs: Bool) -> Bool { return not (self or rhs); }
}

impl CustomOperator<"xnor", Bool, Bool> for Bool {
    attr precedence = 35;
    fn apply(self, rhs: Bool) -> Bool {
        if self == rhs { return true; }
        return false;
    }
}

// `Boolean` gives a type a truth representation so it can be used directly
// as a condition (`if`, `assert!`). Truth is the system `Bool` type —
// `true`/`false`, not an `integer` code. The conversion is applied only in
// condition position — it is not a general implicit cast. The prelude
// exports it; the `Bit`/`Bool` behaviour below is also mirrored inside the
// type checker, and these impls keep the semantics on the record in source.
pub trait Boolean {
    fn as_bool(self) -> Bool;
}

impl Boolean for Bool {
    fn as_bool(self) -> Bool {
        return self;
    }
}

// Parallel-driver resolution (spec 3.14): when one signal is driven from
// several contexts, the compiler folds the contributions pairwise through
// the type's `resolve` (associative, commutative). A type WITHOUT an impl
// is unresolved — parallel drivers on it are an elaboration error.
pub trait Resolve {
    fn resolve(self, rhs: Self) -> Self;
}

// Array behavior is lifted from the element contract. Nominal newtypes over
// arrays forward these implementations from their base without becoming
// interchangeable with that base.
impl<T: Resolve> Resolve for T[] {
    fn resolve(self, rhs: T[]) -> T[] {
        let result: T[] = self;
        for i in self'range { result[i] = self[i].resolve(rhs[i]); }
        return result;
    }
}

impl<T: And<T, T>> And<T, T> for T[] {
    fn and(self, rhs: T[]) -> T[] {
        let result: T[] = self;
        for i in self'range { result[i] = self[i] and rhs[i]; }
        return result;
    }
}

impl<T: Or<T, T>> Or<T, T> for T[] {
    fn or(self, rhs: T[]) -> T[] {
        let result: T[] = self;
        for i in self'range { result[i] = self[i] or rhs[i]; }
        return result;
    }
}

impl<T: CustomOperator<"xor", T, T>> CustomOperator<"xor", T, T> for T[] {
    attr precedence = 35;
    fn apply(self, rhs: T[]) -> T[] {
        let result: T[] = self;
        for i in self'range { result[i] = self[i] xor rhs[i]; }
        return result;
    }
}

impl<T: CustomOperator<"nand", T, T>> CustomOperator<"nand", T, T> for T[] {
    attr precedence = 40;
    fn apply(self, rhs: T[]) -> T[] {
        let result: T[] = self;
        for i in self'range { result[i] = self[i] nand rhs[i]; }
        return result;
    }
}

impl<T: CustomOperator<"nor", T, T>> CustomOperator<"nor", T, T> for T[] {
    attr precedence = 30;
    fn apply(self, rhs: T[]) -> T[] {
        let result: T[] = self;
        for i in self'range { result[i] = self[i] nor rhs[i]; }
        return result;
    }
}

impl<T: CustomOperator<"xnor", T, T>> CustomOperator<"xnor", T, T> for T[] {
    attr precedence = 35;
    fn apply(self, rhs: T[]) -> T[] {
        let result: T[] = self;
        for i in self'range { result[i] = self[i] xnor rhs[i]; }
        return result;
    }
}

impl<T: Not<T>> Not<T> for T[] {
    fn not(self) -> T[] {
        let result: T[] = self;
        for i in self'range { result[i] = not self[i]; }
        return result;
    }
}

// The source-owned interpretation of a packed multi-valued logic element.
// This is intentionally behaviour rather than a marker: it is the SIOX
// counterpart of std_logic_1164's To_X01 conversion plus the information an
// optimized two-plane simulator needs to omit ordinary forcing 0/1 metadata.
//
// `to_bool` is the value plane (weak H/L included), `is_binary` identifies the
// two values whose exact identity needs no companion entry,
// `is_high_impedance` identifies the waveform/resolution neutral level, and
// `to_x01` identifies the canonical X/0/1 result used by numeric operations.
// During elaboration the compiler evaluates these methods for every variant
// and puts the resulting table in the Design; no backend knows ULogic's
// symbols or discriminants.
pub trait LogicEncoding {
    fn to_bool(self) -> Bool;
    fn is_binary(self) -> Bool;
    fn is_high_impedance(self) -> Bool;
    fn to_x01(self) -> Self;
}

// What each declaration is to the compiler. The compiler finds its hooks by
// these roles, never by path.
attr lang for Add = "add";
attr lang for Sub = "sub";
attr lang for Mul = "mul";
attr lang for Div = "div";
attr lang for Shl = "shl";
attr lang for Shr = "shr";
attr lang for And = "and";
attr lang for Or = "or";
attr lang for Not = "not";
attr lang for CustomOperator = "custom_operator";
attr lang for Prefix = "prefix";
attr lang for Suffix = "suffix";
attr lang for Range = "range";
attr lang for Index = "index";
attr lang for IndexAssign = "index_assign";
attr lang for Boolean = "boolean";
attr lang for Resolve = "resolve";
attr lang for LogicEncoding = "logic_encoding";
