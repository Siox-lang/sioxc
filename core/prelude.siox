module core::prelude;

// The core prelude: names in scope in every module, always. `core` is the part
// of the compiler reachable through the language — the hooks the compiler
// calls, the types its grammar produces, its macros — so unlike
// `std::prelude` it does not depend on `--std`: these sources are compiled
// into `sioxc`.

pub use core::primitive::{Bool, string};
pub use core::ops::{Boolean, Range, Index, IndexAssign, Resolve};
pub use core::cmp::{Eq, Ord, Ordering, Match};
pub use core::default::New;
pub use core::convert::From;
pub use core::attrs::precedence;
pub use core::macros::{assert, warn, print, error, write};
pub use core::fmt::{Display, Formatter};
