module core::convert;

// Conversions, as rustc's `core::convert`.

// Explicit conversion for named types (spec 3.17): `T(x)` on a struct/enum
// dispatches to `impl From<Source> for T` (the trait argument names the
// source, like `Add<Rhs, Out>`). Conversions NEVER fire implicitly — only at a
// conversion expression. Kernel numeric conversions (`unsigned[16](x)`,
// `integer(x)`, `resize`) stay width-driven builtins.
pub trait From {
    fn from(v: Self) -> Self;
}

attr lang for From = "from";

// Implicit conversion (docs/proposals/conversions.md): `impl Into<T> for S`
// converts an `S` wherever a `T` is expected — a `let` initializer, an
// assignment, an argument, a returned value — through its own `into` body.
// Never an operator's operand: `a + b` dispatches on the operands' types, so a
// conversion there is written `T(x)`. Unlike Rust's, it is not implied by
// `From`.
pub trait Into {
    fn into(self) -> Self;
}

attr lang for Into = "into";
