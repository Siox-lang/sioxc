module core::cmp;

// Comparison, as rustc's `core::cmp`. Each comparison operator is a method
// returning `Bool`, found through the `eq`/`ord` lang items:
//
//   a == b   a.eq(b)        a < b    a.lt(b)
//   a != b   a.ne(b)        a <= b   a.le(b)
//                           a > b    a.gt(b)
//                           a >= b   a.ge(b)
//
// Equality and order are separate traits, so a type with `==` need not invent
// an order, and an order may leave values unordered (an IEEE NaN compares
// false with everything). These are rustc's `PartialEq` and `PartialOrd`;
// nothing in siox relies on totality, so there is no separate total `Eq`/`Ord`.

// `==` and `!=`.
pub trait Eq<Rhs> {
    fn eq(self, rhs: Rhs) -> Bool;
    fn ne(self, rhs: Rhs) -> Bool { return not self.eq(rhs); }
}

// `<`, `<=`, `>` and `>=`.
pub trait Ord<Rhs> {
    fn lt(self, rhs: Rhs) -> Bool;
    fn le(self, rhs: Rhs) -> Bool;
    fn gt(self, rhs: Rhs) -> Bool { return rhs.lt(self); }
    fn ge(self, rhs: Rhs) -> Bool { return rhs.le(self); }
}

// How a bit-string pattern's character matches an element: `"01--" =>` in
// a `match` tests every position the pattern fixes with
// `element.matches('0')` / `('1')`, and `-` positions match anything. This
// is VHDL-2008's matching equality `?=` (and `std_match`), separate from
// `==`: an element type decides what its weak values and metavalues mean.
// Ranges match through `Ord` instead, and enum variants, `_` and character
// literals match structurally.
pub trait Match<Pattern> {
    fn matches(self, pattern: Pattern) -> Bool;
    // Whether `self` holds a value no pattern can match (a metavalue). A
    // testbench `match` on one warns, as `std_match` reports it.
    fn unknown(self) -> Bool;
}

// A three-way answer, for code that wants one. The compiler gives it no
// meaning: comparisons go through `Eq` and `Ord`.
pub enum Ordering {
    Less,
    Equal,
    Greater
}

attr lang for Eq = "eq";
attr lang for Ord = "ord";
