module core::attrs;

// The attributes the compiler reads: `precedence` (a user operator's binding
// power, read while parsing) and `lang` (what a `core`/`std` declaration is to
// the compiler). Directives — `#[test]`, `#[allow(..)]`, `#[warn(..)]`,
// `#[deny(..)]`, `#[forbid(..)]` — are not attributes: like rustc's, they are
// built into the compiler and declared nowhere.

// Binding power for a custom infix operator implementation; `0` means none.
pub attr precedence: integer for impl = 0;

// What a `core` or `std` declaration is to the compiler: `attr lang for
// Add = "add";`. Only `core` and `std` may bind it.
pub attr lang: string for trait, enum, struct, attr = "";

