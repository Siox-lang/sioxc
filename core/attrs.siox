module core::attrs;

use core::ops::Bool;

// The compiler's directives and the attributes it reads (spec 3.5, 3.5a).
// `std::attrs` re-exports them beside the metadata no compiler reads.
//
//   #[test]                   compile this entity into `sioxc --test`
//   #[allow(lint, ...)]       do not report these lints in the next item
//   #[warn(lint, ...)]        report them as warnings (the default)
//   #[deny(lint, ...)]        report them as errors
//   #[forbid(lint, ...)]      as `deny`, and no inner directive may lower it
//
// A lint directive governs the item or statement it precedes; `#![...]`
// right after `module` governs the whole module. `-A`/`-W`/`-D`/`-F` set
// levels for every module from the command line.

pub attr test: Bool for entity = false;     // discovered by `sioxc --test`
pub attr allow: Lint for item;
pub attr warn: Lint for item;
pub attr deny: Lint for item;
pub attr forbid: Lint for item;

// Every lint, by the name a directive uses. `warnings` names them all.
pub enum Lint {
    warnings,
    possible_latch,             // W-P002
    unused_signal,              // W-P003
    unused_param,               // W-P004
    unused_import,              // W-P005
    unreachable_match_arm,      // W-P006
    non_exhaustive_match,       // W-P007
    suspicious_logic_compare,   // W-P008
    suspicious_reset,           // W-P009
    combinational_loop,         // W-P010
    undriven_output,            // W-P011
    unconnected_input,          // W-P012
    dead_assignment,            // W-P014
    unimplemented_attr,         // W-P015
    incomplete_struct_literal,  // W-P016
    unknown_lints               // W-P017
}

// Binding power for a custom infix operator implementation; `0` means none.
pub attr precedence: integer for impl = 0;

// What a `core` or `std` declaration is to the compiler: `attr lang for
// Operator = "operator";`. Only `core` and `std` may bind it.
pub attr lang: string for trait, enum, struct, attr = "";

attr lang for test = "test";
