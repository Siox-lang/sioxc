module std::attrs;

// The base metadata (spec 3.5): what nearly every flow needs to know about a
// design, which the compiler preserves without giving it semantics. Vendor
// settings — RAM styles, FSM encodings, pin assignments, I/O standards —
// belong in vendor packages (`attr vivado::ram_style for …`), not here.
//
// Every declaration carries a default, so a read (`probe'keep`) always has a
// value. Bind one from outside the declaration it describes:
// `attr keep for probe = true;`.
//
// Directives (`#[test]`, `#[allow(..)]`, …) are not attributes: they are
// built into the compiler. The attributes the compiler itself reads
// (`precedence`, `lang`) are in `core::attrs`.

pub attr keep: Bool for let, port = false;  // keep through optimization
pub attr top: Bool for entity = false;      // the design's top entity, for tools
pub attr clock: Bool for port = false;      // this port is a clock input
pub attr library: string for entity = "";   // a foreign entity's library
pub attr name: string for entity = "";      // a foreign entity's name there
