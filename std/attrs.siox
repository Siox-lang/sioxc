module std::attrs;

// Metadata attributes (spec 3.5): what tools and vendor flows read and the
// compiler preserves without giving it semantics. Tool/vendor metadata such
// as `top` is declared by the owning integration rather than by std.
//
// Every declaration carries a default, so a read (`probe'keep`) always has a
// value. Bind one from outside the declaration it describes:
// `attr keep for probe = true;`, or objectless inside an impl,
// `attr precedence = 40;`.
//
// The directives (`#[test]`, `#[allow(..)]`, …) and `precedence` change what
// the compiler does, so they are declared in `core::attrs`; they are
// re-exported here and reach every module through the prelude.

pub use core::attrs::{test, allow, warn, deny, forbid, Lint, precedence};

pub attr keep: Bool for let, port = false;  // keep through optimization
pub attr library: string for entity = "";
pub attr name: string for entity = "";
