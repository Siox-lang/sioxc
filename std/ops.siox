module std::ops;

use std::logic::Bit;

// The operator and value hooks are the compiler's and live in `core::ops`;
// this module re-exports them and implements them for `Bit`.
pub use core::ops::{
    Operator, Prefix, Suffix, Range, Index, IndexAssign, Ordering, Boolean, Resolve, New, From
};

impl Operator<"and", Bit, Bit> for Bit {
    fn apply(self, rhs: Bit) -> Bit {
        if self == '1' {
            return rhs;
        }
        return '0';
    }
}

impl Operator<"or", Bit, Bit> for Bit {
    fn apply(self, rhs: Bit) -> Bit {
        if self == '1' { return '1'; }
        return rhs;
    }
}

impl Operator<"not", Bit, Bit> for Bit {
    fn apply(self) -> Bit {
        if self == '1' { return '0'; }
        return '1';
    }
}

impl Operator<"xor", Bit, Bit> for Bit {
    attr precedence = 35;
    fn apply(self, rhs: Bit) -> Bit {
        if self == rhs { return '0'; }
        return '1';
    }
}

impl Operator<"nand", Bit, Bit> for Bit {
    attr precedence = 40;
    fn apply(self, rhs: Bit) -> Bit { return not (self and rhs); }
}

impl Operator<"nor", Bit, Bit> for Bit {
    attr precedence = 30;
    fn apply(self, rhs: Bit) -> Bit { return not (self or rhs); }
}

impl Operator<"xnor", Bit, Bit> for Bit {
    attr precedence = 35;
    fn apply(self, rhs: Bit) -> Bit {
        if self == rhs { return '1'; }
        return '0';
    }
}

impl Boolean for Bit {
    fn as_bool(self) -> Bool {
        if self == '1' {
            return true;
        } else {
            return false;
        }
    }
}
