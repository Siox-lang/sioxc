module std::ops;

using std::logic::{Bit, Bool};

// Operator overloading is Rust-style (spec 3.25) but goes through a single
// symbol-parameterized trait: `a <op> b` dispatches to
// `impl Operator<"<op>", Input, Output> for <type of a>` (method `apply`;
// overloads select by the rhs/`Input` type, and the impl's `Output` names the
// result type). The standard symbols (`+ - * / << >> and or not <=>`) carry
// built-in precedence; a user operator such as `xor` declares its precedence
// with `#[precedence = N]`. Unary `not` implements `apply(self)` with no rhs.
// The three-way `<=>` returns `Ordering` and derives all of < <= > >= == !=.
pub trait Operator<op: string, input, output> {
    fn apply(self, rhs: input) -> output {}
}

// Literal affixes are symbol-parameterized the same way (spec 3.24): the first
// argument is the affix string, the second the literal's data type.
//   - a bit-string prefix `x"AB"` dispatches to `impl Prefix<"x", string> for T`
//   - a numeric suffix `10ns` dispatches to `impl Suffix<"ns", integer> for T`
// The impl's target type is what the literal produces; prefix evaluation is a
// compiler intrinsic (radix expansion) until const string operations land, so
// prefix impls inherit the empty default body.
pub trait Prefix<char: string, T> {
    fn prefix(data: T) {}
}

pub trait Suffix<char: string, T> {
    fn suffix(data: T) {}
}

// Inclusive index ranges are ordinary values when indexing is overloaded.
// Partial source forms (`..right`, `left..`, `..`) are completed from the indexed
// object's declared bounds before dispatch.
pub struct Range {
    left: integer,
    right: integer
}

// `value[index]` falls back to Index when `value` is not an intrinsic packed
// vector or array. `value[index] = next` similarly uses IndexAssign.
pub trait Index<I, Output> {
    fn index(self, index: I) -> Output;
}

pub trait IndexAssign<I, Value> {
    fn index_assign(self, index: I, value: Value);
}

// `and`/`or` have one type-directed meaning. For Bool-like operands they are
// scalar boolean logic; for bit-derived operands they apply per bit.
impl Operator<"and", Bool, Bool> for Bool {
    fn apply(self, rhs: Bool) -> Bool {
        if self {
            return rhs;
        }
        return false;
    }
}

impl Operator<"or", Bool, Bool> for Bool {
    fn apply(self, rhs: Bool) -> Bool {
        if self { return true; }
        return rhs;
    }
}

impl Operator<"not", Bool, Bool> for Bool {
    fn apply(self) -> Bool {
        if self { return false; }
        return true;
    }
}

#[precedence = 35]
impl Operator<"xor", Bool, Bool> for Bool {
    fn apply(self, rhs: Bool) -> Bool {
        if self { return not rhs; }
        return rhs;
    }
}

#[precedence = 40]
impl Operator<"nand", Bool, Bool> for Bool {
    fn apply(self, rhs: Bool) -> Bool { return not (self and rhs); }
}

#[precedence = 30]
impl Operator<"nor", Bool, Bool> for Bool {
    fn apply(self, rhs: Bool) -> Bool { return not (self or rhs); }
}

#[precedence = 35]
impl Operator<"xnor", Bool, Bool> for Bool {
    fn apply(self, rhs: Bool) -> Bool {
        if self == rhs { return true; }
        return false;
    }
}

impl Operator<"and", Bit, Bit> for Bit {
    fn apply(self, rhs: Bit) -> Bit {
        if self == '1' {
            return rhs;
        }
        return '0';
    }
}

impl Operator<"or", Bit, Bit> for Bit {
    fn apply(self, rhs: Bit) -> Bit {
        if self == '1' { return '1'; }
        return rhs;
    }
}

impl Operator<"not", Bit, Bit> for Bit {
    fn apply(self) -> Bit {
        if self == '1' { return '0'; }
        return '1';
    }
}

#[precedence = 35]
impl Operator<"xor", Bit, Bit> for Bit {
    fn apply(self, rhs: Bit) -> Bit {
        if self == rhs { return '0'; }
        return '1';
    }
}

#[precedence = 40]
impl Operator<"nand", Bit, Bit> for Bit {
    fn apply(self, rhs: Bit) -> Bit { return not (self and rhs); }
}

#[precedence = 30]
impl Operator<"nor", Bit, Bit> for Bit {
    fn apply(self, rhs: Bit) -> Bit { return not (self or rhs); }
}

#[precedence = 35]
impl Operator<"xnor", Bit, Bit> for Bit {
    fn apply(self, rhs: Bit) -> Bit {
        if self == rhs { return '1'; }
        return '0';
    }
}
//
// `Boolean` gives a type a truth representation so it can be used directly
// as a condition (in `if`, and later `while`/assertions). Truth is the system
// `Bool` type — `true`/`false`, not an `integer` code. The conversion is
// applied only in condition position — it is not a general implicit cast.
//
// This is the canonical declaration of `Boolean`; name it with
// `using std::ops::{Boolean};`. The `Bit`/`Bool` condition behaviour below is
// also mirrored inside the type checker so plain `if bit` works without an
// import — the impls here keep the semantics on the record in source form.

// The result of a three-way comparison (`impl Operator<"<=>", T, Ordering>`,
// spec 3.25). One `<=>` impl derives all of < <= > >= == != — like Rust's Ord.
// Discriminants are fixed (Less=0, Equal=1, Greater=2); the derived
// comparisons test against them.
pub enum Ordering {
    Less,
    Equal,
    Greater
}

pub trait Boolean {
    fn as_bool(self) -> Bool;
}

// Opts an unconstrained scalar-array newtype into packed numeric storage.
// Field-less newtypes derived from a Vector family inherit the capability.
pub trait Vector {}

impl Boolean for Bit {
    fn as_bool(self) -> Bool {
        if self == '1' {
            return true;
        } else {
            return false;
        }
    }
}

impl Boolean for Bool {
    fn as_bool(self) -> Bool {
        return self;
    }
}

// Parallel-driver resolution (spec 3.14): when one signal is driven from
// several contexts, the compiler folds the contributions pairwise through
// the type's `resolve` (associative, commutative). A type WITHOUT an impl
// is unresolved — parallel drivers on it are an elaboration error.
pub trait Resolve {
    fn resolve(self, rhs: Self) -> Self;
}

// Array behavior is lifted from the element contract. Fieldless nominal
// Vector newtypes forward these implementations from their array base without
// becoming interchangeable with that base.
impl<T: Resolve> Resolve for T[] {
    fn resolve(self, rhs: T[]) -> T[] {
        let result: T[] = self;
        for i in self'range { result[i] = self[i].resolve(rhs[i]); }
        return result;
    }
}

impl<T: Operator<"and", T, T>> Operator<"and", T, T> for T[] {
    fn apply(self, rhs: T[]) -> T[] {
        let result: T[] = self;
        for i in self'range { result[i] = self[i] and rhs[i]; }
        return result;
    }
}

impl<T: Operator<"or", T, T>> Operator<"or", T, T> for T[] {
    fn apply(self, rhs: T[]) -> T[] {
        let result: T[] = self;
        for i in self'range { result[i] = self[i] or rhs[i]; }
        return result;
    }
}

impl<T: Operator<"not", T, T>> Operator<"not", T, T> for T[] {
    fn apply(self) -> T[] {
        let result: T[] = self;
        for i in self'range { result[i] = not self[i]; }
        return result;
    }
}

// The default constructor (language.md 3.29): the value an uninitialized signal
// of `T` powers on to, and the nullary member of the `T(...)` family. The body
// must be a constant. Absent an impl, the compiler uses the type's first
// variant / zero.
pub trait New {
    fn new() -> Self;
}

// Explicit conversion for named types (spec 3.17): `T(x)` on a struct/enum
// dispatches to `impl From<Source> for T` (the trait argument names the
// source, like `Operator<Rhs>`). Conversions NEVER fire implicitly — only at a
// conversion expression. Kernel numeric conversions (`unsigned[16](x)`,
// `integer(x)`, `resize`) stay width-driven builtins.
pub trait From {
    fn from(v: Self) -> Self;
}
