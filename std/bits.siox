module std::bits;

use std::logic::Logic;

// `unsigned` and `signed` are ordinary library types, not compiler-magic
// names. Deriving from `Logic[]` supplies their array representation. The
// names come from
// ieee.numeric_std, where they are likewise arrays of std_logic declared in
// library code.
//
// The names are the only thing that says "signed": nothing in the compiler
// tracks signedness. It is defined entirely by the operator impls below —
// `signed`'s `Ord` is a signed compare, its `>>` an arithmetic shift, its `/`
// a signed divide — and the compiler just dispatches to whichever impls a
// type declares. A type named neither would behave the same as its impls say.
pub struct unsigned(Logic[]);
pub struct signed(Logic[]);

//   unsigned[N]  N bits, wrapping on overflow           (VHDL `unsigned`)
//   signed[N]    N bits, two's complement               (VHDL `signed`)
//
// Both are newtypes over `Logic[]`: a vector of Logic with a numeric
// interpretation, whose assignment accepts the kernel base type `integer`
// (`let x: unsigned[8] = 42;`). Only the kernel types `integer` and `real`
// have built-in operators; these get theirs HERE, as Rust-style trait impls
// (spec 3.25). Inside an operator impl the operands read as kernel words, so
// `self + rhs` below is the built-in integer add — results wrap to the
// target's width when stored, which is what makes `unsigned[N]` modular.
// Comparisons on `unsigned` use kernel unsigned semantics; the explicit
// `Eq`/`Ord` impls below expose them through the comparison traits, and
// `signed` declares its own sign-aware `Ord` further down.

// --- unsigned[N]: modular unsigned arithmetic -------------------------------

impl Add<unsigned, unsigned> for unsigned {
    fn add(self, rhs: unsigned) -> unsigned { return self + rhs; }
}

impl Sub<unsigned, unsigned> for unsigned {
    fn sub(self, rhs: unsigned) -> unsigned { return self - rhs; }
}

impl Mul<unsigned, unsigned> for unsigned {
    fn mul(self, rhs: unsigned) -> unsigned { return self * rhs; }
}

impl Div<unsigned, unsigned> for unsigned {
    fn div(self, rhs: unsigned) -> unsigned { return self / rhs; }
}

impl Shl<unsigned, unsigned> for unsigned {
    fn shl(self, rhs: unsigned) -> unsigned { return self << rhs; }
}

impl Shr<unsigned, unsigned> for unsigned {
    fn shr(self, rhs: unsigned) -> unsigned { return self >> rhs; }
}

impl Eq<unsigned> for unsigned {
    fn eq(self, rhs: unsigned) -> Bool { return self == rhs; }
}

impl Ord<unsigned> for unsigned {
    fn lt(self, rhs: unsigned) -> Bool { return self < rhs; }
    fn le(self, rhs: unsigned) -> Bool { return self <= rhs; }
}

// `abs`, `rem` and `mod` are functions, as for `integer` (core::primitive).
// An unsigned value is its own magnitude, and its `rem` and `mod` agree.
impl unsigned {
    pub fn abs(self) -> unsigned { return self; }
    pub fn rem(self, m: unsigned) -> unsigned { return self - (self / m) * m; }
    pub fn mod(self, m: unsigned) -> unsigned { return self - (self / m) * m; }
}

// Radix bit-string prefixes (spec 3.24), VHDL-style: `x"AB"` is hex (4
// bits/digit) and `o"17"` octal (3 bits/digit). The symbol parameterizes the
// `Prefix` trait — the compiler names the trait, std owns which prefixes exist
// — while evaluation stays a compiler intrinsic (radix expansion) until const
// string operations land, so each impl inherits the empty default body. A
// plain string of logic values (`"1X10"`) needs no prefix: it reads as a Logic
// array by context.
impl Prefix<"x", string> for unsigned {}
impl Prefix<"o", string> for unsigned {}

// Core `and`/`or`/`not` are boolean-per-bit. The remaining familiar logic
// words are ordinary custom operators declared here for numeric vectors.

impl CustomOperator<"xor", unsigned, unsigned> for unsigned {
    attr precedence = 35;
    fn apply(self, rhs: unsigned) -> unsigned { return (self or rhs) - (self and rhs); }
}

impl CustomOperator<"nand", unsigned, unsigned> for unsigned {
    attr precedence = 40;
    fn apply(self, rhs: unsigned) -> unsigned {
        return ((1 << self'length) - 1) - (self and rhs);
    }
}

impl CustomOperator<"nor", unsigned, unsigned> for unsigned {
    attr precedence = 30;
    fn apply(self, rhs: unsigned) -> unsigned {
        return ((1 << self'length) - 1) - (self or rhs);
    }
}

impl CustomOperator<"xnor", unsigned, unsigned> for unsigned {
    attr precedence = 35;
    fn apply(self, rhs: unsigned) -> unsigned {
        return ((1 << self'length) - 1) - ((self or rhs) - (self and rhs));
    }
}

impl CustomOperator<"xor", signed, signed> for signed {
    attr precedence = 35;
    fn apply(self, rhs: signed) -> signed { return (self or rhs) - (self and rhs); }
}

impl CustomOperator<"nand", signed, signed> for signed {
    attr precedence = 40;
    fn apply(self, rhs: signed) -> signed {
        return ((1 << self'length) - 1) - (self and rhs);
    }
}

impl CustomOperator<"nor", signed, signed> for signed {
    attr precedence = 30;
    fn apply(self, rhs: signed) -> signed {
        return ((1 << self'length) - 1) - (self or rhs);
    }
}

impl CustomOperator<"xnor", signed, signed> for signed {
    attr precedence = 35;
    fn apply(self, rhs: signed) -> signed {
        return ((1 << self'length) - 1) - ((self or rhs) - (self and rhs));
    }
}

// --- signed[N]: two's-complement signed --------------------------------------

// Sign-extension is a library operation now that the compiler tracks no
// signedness: `integer(x)` reads the raw (unsigned) bits, so `sext` recovers
// the signed value by subtracting 2^width when the sign bit is set. Widen a
// signed vector with `signed[N](sext(x))`.
pub fn sext(x: signed) -> integer {
    // Test the sign bit on the RAW value: `x >> ..` would use signed's own
    // (arithmetic) shift, but here we want the plain top bit.
    if (integer(x) >> (x'length - 1)) == 1 {
        return integer(x) - (1 << x'length);
    }
    return integer(x);
}


impl Add<signed, signed> for signed {
    fn add(self, rhs: signed) -> signed { return self + rhs; }
}

impl Sub<signed, signed> for signed {
    fn sub(self, rhs: signed) -> signed { return self - rhs; }
}

impl Mul<signed, signed> for signed {
    fn mul(self, rhs: signed) -> signed { return self * rhs; }
}

// Signed division: divide the magnitudes with the kernel's unsigned divide,
// then restore the sign. `resize(0 - x, w)` is |x| for a negative x (the
// word-wrapping negate, truncated back to the operand's width); results
// wrap to the target's width when stored, which re-encodes a negative
// quotient as two's complement.
// The sign test reads the RAW top bit, like `sext` above: `self >> ..` here
// dispatches signed's own arithmetic shift, which fills with the sign, so a
// negative operand tests as all-ones and never equals 1. (The `>>` impl
// below spells it the short way safely — a `>>` nested inside that body is
// the built-in shift, not a re-entry into this dispatch.)
//
// `resize(x, x'length)` narrows the operand to its own width first. A signal
// already holds exactly that many bits, but a constant operand does not:
// `0 - 2` is computed full-width, so its bit 7 was clear and a negative
// literal divisor tested as positive.
impl Div<signed, signed> for signed {
    fn div(self, rhs: signed) -> signed {
        if ((integer(resize(self, self'length)) >> (self'length - 1)) == 1)
            and ((integer(resize(rhs, rhs'length)) >> (rhs'length - 1)) == 1) {
            return resize(0 - self, self'length) / resize(0 - rhs, rhs'length);
        }
        if (integer(resize(self, self'length)) >> (self'length - 1)) == 1 {
            return 0 - (resize(0 - self, self'length) / rhs);
        }
        if (integer(resize(rhs, rhs'length)) >> (rhs'length - 1)) == 1 {
            return 0 - (self / resize(0 - rhs, rhs'length));
        }
        return self / rhs;
    }
}

impl Shl<signed, signed> for signed {
    fn shl(self, rhs: signed) -> signed { return self << rhs; }
}

// Arithmetic shift-right: replicate the sign into the vacated top bits.
// `(1 << w) - (1 << (w - n))` is a mask of the top n bits (the shifted-in
// positions); the shifted value's top bits are zero, so `+` sets them.
impl Shr<signed, signed> for signed {
    fn shr(self, rhs: signed) -> signed {
        if (self >> (self'length - 1)) == 1 {
            return (self >> rhs) + ((1 << self'length) - (1 << (self'length - rhs)));
        }
        return self >> rhs;
    }
}

impl Eq<signed> for signed {
    fn eq(self, rhs: signed) -> Bool { return self == rhs; }
}

// Sign-aware order: `self'length` is the operand's bit width, so the raw word
// shifted by `self'length - 1` is non-zero exactly when the sign bit is set
// (at 64 bits the kernel integer's own shift makes it -1, not 1). It reads
// the RAW word,
// narrowed to the operand's width as the `/` impl does: `self >> ..` would
// dispatch signed's own arithmetic shift. A negative orders below a
// non-negative; same-sign two's-complement values order like their unsigned
// words, which is the built-in comparison inside these bodies (spec 3.25).
impl Ord<signed> for signed {
    fn lt(self, rhs: signed) -> Bool {
        if ((integer(resize(self, self'length)) >> (self'length - 1)) != 0)
            != ((integer(resize(rhs, rhs'length)) >> (rhs'length - 1)) != 0) {
            return (integer(resize(self, self'length)) >> (self'length - 1)) != 0;
        }
        return self < rhs;
    }
    fn le(self, rhs: signed) -> Bool { return not rhs.lt(self); }
}

// `rem` takes the dividend's sign (VHDL `rem`), `mod` the divisor's (VHDL
// `mod`); `/` truncates toward zero.
impl signed {
    pub fn abs(self) -> signed {
        if self < 0 { return 0 - self; }
        return self;
    }

    pub fn rem(self, m: signed) -> signed { return self - (self / m) * m; }

    pub fn mod(self, m: signed) -> signed {
        if self.rem(m) != 0 and (self.rem(m) < 0) != (m < 0) { return self.rem(m) + m; }
        return self.rem(m);
    }
}
