module std::alloc::string;

// `String`: growable text, as Rust's `alloc::string::String`. Fixed text is
// `Char[N]` (a literal `"abc"` is a `Char[3]`); a `Char[N]` assigns into a
// `String`, never the reverse. Its characters live in the simulator, so a
// `String` is testbench storage with no hardware form. See
// `docs/proposals/alloc.md`.

pub struct String {}

attr lang for String = "String";

impl String {
    // The number of characters.
    pub fn len() -> integer {
        return self'length;
    }

    // Whether it holds no characters.
    pub fn is_empty() -> Bool {
        return self'length == 0;
    }

    // Appends a character.
    // ponytail: copies the text each time; an in-place runtime append if a
    // testbench builds long strings a character at a time.
    pub fn push(c: Char) {
        self = format!("{}{}", self, c);
    }

    // Appends text: another `String`, or fixed text.
    pub fn push_str(text: String) {
        self = format!("{}{}", self, text);
    }

    // Removes every character.
    pub fn clear() {
        self = "";
    }
}
