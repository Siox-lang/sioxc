module std::fixed;


// Fixed-point numbers, after VHDL-2008's `fixed_pkg`. The binary point lives in
// the index range, exactly as in VHDL's `ufixed(3 downto -4)`:
//
//   ufixed[3..-4]   4 integer bits (indices 3..0) and 4 fraction bits (-1..-4)
//   sfixed[7..-8]   the same in two's complement: 8 integer bits, 8 fraction
//
// so `x'high + 1` is the integer width and `-x'low` the fraction width, and
// the types are ordinary newtypes over `Logic[]`, like `unsigned`/`signed`.
//
// Operands of one format give that format. A sum wraps on overflow, as
// `unsigned` does; a product drops its extra fraction bits rounding toward
// minus infinity (VHDL's truncate). Inside these impls the operands read as
// kernel words: `self * rhs` is the full product, which the shift by the
// fraction width brings back to the format before it is stored.
pub struct ufixed(Logic[]);
pub struct sfixed(Logic[]);

// --- ufixed ------------------------------------------------------------------

impl Add<ufixed, ufixed> for ufixed {
    fn add(self, rhs: ufixed) -> ufixed { return self + rhs; }
}

impl Sub<ufixed, ufixed> for ufixed {
    fn sub(self, rhs: ufixed) -> ufixed { return self - rhs; }
}

impl Mul<ufixed, ufixed> for ufixed {
    fn mul(self, rhs: ufixed) -> ufixed { return (self * rhs) >> (0 - self'low); }
}

impl Eq<ufixed> for ufixed {
    fn eq(self, rhs: ufixed) -> Bool { return self == rhs; }
}

impl Ord<ufixed> for ufixed {
    fn lt(self, rhs: ufixed) -> Bool { return self < rhs; }
    fn le(self, rhs: ufixed) -> Bool { return self <= rhs; }
}

impl ufixed {
    // The number this holds.
    pub fn to_real(self) -> real {
        return real(integer(self)) / real(1 << (0 - self'low));
    }
}

// --- sfixed ------------------------------------------------------------------

impl Add<sfixed, sfixed> for sfixed {
    fn add(self, rhs: sfixed) -> sfixed { return self + rhs; }
}

impl Sub<sfixed, sfixed> for sfixed {
    fn sub(self, rhs: sfixed) -> sfixed { return self - rhs; }
}

// The words multiply as unsigned; a negative operand read unsigned is its
// value plus 2^L, so the signed product is the unsigned one less 2^L times the
// other operand for each negative operand. Its low 2L bits are then exact,
// and the shift by the fraction width selects the result's bits.
impl Mul<sfixed, sfixed> for sfixed {
    fn mul(self, rhs: sfixed) -> sfixed {
        return ((self * rhs)
            - (((self >> (self'length - 1)) * rhs) << self'length)
            - (((rhs >> (rhs'length - 1)) * self) << rhs'length))
            >> (0 - self'low);
    }
}

impl Eq<sfixed> for sfixed {
    fn eq(self, rhs: sfixed) -> Bool { return self == rhs; }
}

// Sign-aware order, as `signed`'s: a set sign bit orders below a clear one,
// and same-sign two's-complement values order like their unsigned words.
impl Ord<sfixed> for sfixed {
    fn lt(self, rhs: sfixed) -> Bool {
        if ((integer(resize(self, self'length)) >> (self'length - 1)) != 0)
            != ((integer(resize(rhs, rhs'length)) >> (rhs'length - 1)) != 0) {
            return (integer(resize(self, self'length)) >> (self'length - 1)) != 0;
        }
        return self < rhs;
    }
    fn le(self, rhs: sfixed) -> Bool { return not rhs.lt(self); }
}

impl sfixed {
    // The number this holds.
    pub fn to_real(self) -> real {
        let word: integer = integer(self);
        let value: integer = word - ((word >> (self'length - 1)) << self'length);
        return real(value) / real(1 << (0 - self'low));
    }
}

// --- from real ---------------------------------------------------------------

// `ufixed[3..-4](2.5)`: a number in the format being built (`Self'high`
// down to `Self'low`), rounded to the nearest step (ties away from zero) and
// saturated to the format's range, VHDL's defaults.
impl From<real> for ufixed {
    fn from(value: real) -> ufixed { return ufixed_word(value, Self'high, Self'low); }
}

impl From<integer> for ufixed {
    fn from(value: integer) -> ufixed { return ufixed_word(real(value), Self'high, Self'low); }
}

impl From<real> for sfixed {
    fn from(value: real) -> sfixed { return sfixed_word(value, Self'high, Self'low); }
}

impl From<integer> for sfixed {
    fn from(value: integer) -> sfixed { return sfixed_word(real(value), Self'high, Self'low); }
}

// The words of `value` in the format `[left..right]`.
fn ufixed_word(value: real, left: integer, right: integer) -> integer {
    let steps: real = value * real(1 << (0 - right));
    let largest: integer = (1 << (left - right + 1)) - 1;
    if steps <= 0.0 { return 0; }
    if steps >= real(largest) { return largest; }
    return integer(steps + 0.5);
}

fn sfixed_word(value: real, left: integer, right: integer) -> integer {
    let steps: real = value * real(1 << (0 - right));
    let largest: integer = (1 << (left - right)) - 1;
    let smallest: integer = 0 - (1 << (left - right));
    if steps >= real(largest) { return largest; }
    if steps <= real(smallest) { return smallest; }
    if steps < 0.0 { return 0 - integer(0.5 - steps); }
    return integer(steps + 0.5);
}
