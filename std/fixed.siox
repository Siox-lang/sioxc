module std::fixed;


// Fixed-point numbers, after VHDL-2008's `fixed_pkg`. The parameters are the
// format: W bits in all, F of them fraction.
//
//   ufixed<8, 4>    4 integer bits and 4 fraction bits (4.4)
//   sfixed<16, 8>   8.8 in two's complement
//
// Internally the word is indexed as VHDL's `ufixed(3 downto -4)` is, so
// `x'high + 1` is the integer width and `-x'low` the fraction width, and the
// types are ordinary newtypes over `Logic[]`, like `unsigned`/`signed`.
//
// Operands of one format give that format. A sum wraps on overflow, as
// `unsigned` does; a product or quotient drops its extra fraction bits
// rounding toward minus infinity (VHDL's truncate), and a quotient by zero is
// zero. Between formats, the constructor resizes: `ufixed<12, 6>(x)` rounds to
// the nearest step and saturates, VHDL's `resize` defaults. Inside these impls the operands read as
// kernel words: `self * rhs` is the full product, which the shift by the
// fraction width brings back to the format before it is stored.
pub struct ufixed<W: integer, F: integer>(Logic[W - F - 1 .. 0 - F]);
pub struct sfixed<W: integer, F: integer>(Logic[W - F - 1 .. 0 - F]);

// --- ufixed ------------------------------------------------------------------

impl Add<ufixed, ufixed> for ufixed {
    fn add(self, rhs: ufixed) -> ufixed { return self + rhs; }
}

impl Sub<ufixed, ufixed> for ufixed {
    fn sub(self, rhs: ufixed) -> ufixed { return self - rhs; }
}

impl Mul<ufixed, ufixed> for ufixed {
    fn mul(self, rhs: ufixed) -> ufixed { return (self * rhs) >> (0 - self'low); }
}

// The dividend is scaled by the fraction width first, so the quotient of the
// words is in the format.
impl Div<ufixed, ufixed> for ufixed {
    fn div(self, rhs: ufixed) -> ufixed {
        return floor_div(word(self) << (0 - self'low), word(rhs));
    }
}

impl Eq<ufixed> for ufixed {
    fn eq(self, rhs: ufixed) -> Bool { return self == rhs; }
}

impl Ord<ufixed> for ufixed {
    fn lt(self, rhs: ufixed) -> Bool { return self < rhs; }
    fn le(self, rhs: ufixed) -> Bool { return self <= rhs; }
}

// Each format prints as its value, with the caller's precision.
impl Display for ufixed {
    fn fmt(self, f: Formatter) {
        write!(f, "{}", self.to_real());
    }
}

impl Display for sfixed {
    fn fmt(self, f: Formatter) {
        write!(f, "{}", self.to_real());
    }
}

impl ufixed {
    // The number this holds.
    pub fn to_real(self) -> real {
        return real(word(self)) / real(1 << (0 - self'low));
    }
}

// --- sfixed ------------------------------------------------------------------

impl Add<sfixed, sfixed> for sfixed {
    fn add(self, rhs: sfixed) -> sfixed { return self + rhs; }
}

impl Sub<sfixed, sfixed> for sfixed {
    fn sub(self, rhs: sfixed) -> sfixed { return self - rhs; }
}

// The words multiply as unsigned; a negative operand read unsigned is its
// value plus 2^L, so the signed product is the unsigned one less 2^L times the
// other operand for each negative operand. Its low 2L bits are then exact,
// and the shift by the fraction width selects the result's bits.
impl Mul<sfixed, sfixed> for sfixed {
    fn mul(self, rhs: sfixed) -> sfixed {
        return ((self * rhs)
            - (((self >> (self'length - 1)) * rhs) << self'length)
            - (((rhs >> (rhs'length - 1)) * self) << rhs'length))
            >> (0 - self'low);
    }
}

impl Div<sfixed, sfixed> for sfixed {
    fn div(self, rhs: sfixed) -> sfixed {
        return floor_div(
            sext_word(word(self), self'length) << (0 - self'low),
            sext_word(word(rhs), rhs'length)
        );
    }
}

impl Eq<sfixed> for sfixed {
    fn eq(self, rhs: sfixed) -> Bool { return self == rhs; }
}

// Sign-aware order, as `signed`'s: a set sign bit orders below a clear one,
// and same-sign two's-complement values order like their unsigned words.
impl Ord<sfixed> for sfixed {
    fn lt(self, rhs: sfixed) -> Bool {
        if ((integer(resize(self, self'length)) >> (self'length - 1)) != 0)
            != ((integer(resize(rhs, rhs'length)) >> (rhs'length - 1)) != 0) {
            return (integer(resize(self, self'length)) >> (self'length - 1)) != 0;
        }
        return self < rhs;
    }
    fn le(self, rhs: sfixed) -> Bool { return not rhs.lt(self); }
}

impl sfixed {
    // The number this holds.
    pub fn to_real(self) -> real {
        return real(sext_word(word(self), self'length)) / real(1 << (0 - self'low));
    }
}

// --- from real ---------------------------------------------------------------

// `ufixed<8, 4>(2.5)`: a number in the format being built (`Self'high`
// down to `Self'low`), rounded to the nearest step (ties away from zero) and
// saturated to the format's range, VHDL's defaults.
impl From<real> for ufixed {
    fn from(value: real) -> ufixed { return ufixed_word(value, Self'high, Self'low); }
}

impl From<integer> for ufixed {
    fn from(value: integer) -> ufixed { return ufixed_word(real(value), Self'high, Self'low); }
}

impl From<real> for sfixed {
    fn from(value: real) -> sfixed { return sfixed_word(value, Self'high, Self'low); }
}

impl From<integer> for sfixed {
    fn from(value: integer) -> sfixed { return sfixed_word(real(value), Self'high, Self'low); }
}

// --- between formats ---------------------------------------------------------

// `ufixed<12, 6>(x)` from another `ufixed`, `sfixed<8, 4>(y)` from another
// `sfixed`: rounded to the nearest step (ties away from zero) and saturated.
impl From<ufixed> for ufixed {
    fn from(value: ufixed) -> ufixed {
        return rescale(word(value), 0 - value'low, Self'high, Self'low, false);
    }
}

impl From<sfixed> for sfixed {
    fn from(value: sfixed) -> sfixed {
        return rescale(
            sext_word(word(value), value'length), 0 - value'low, Self'high, Self'low, true
        );
    }
}

// The number `n`, with `fraction` fraction bits, in the format
// `[left..right]`.
fn rescale(n: integer, fraction: integer, left: integer, right: integer, is_signed: Bool) -> integer {
    return clamp(
        scale(n, fraction, right),
        smallest(left, right, is_signed),
        largest(left, right, is_signed)
    );
}

// `n` with `fraction` fraction bits, as steps of `2^right`.
fn scale(n: integer, fraction: integer, right: integer) -> integer {
    if 0 - right >= fraction { return n << (0 - right - fraction); }
    return round_shift(n, fraction + right);
}

fn largest(left: integer, right: integer, is_signed: Bool) -> integer {
    if is_signed { return (1 << (left - right)) - 1; }
    return (1 << (left - right + 1)) - 1;
}

fn smallest(left: integer, right: integer, is_signed: Bool) -> integer {
    if is_signed { return 0 - (1 << (left - right)); }
    return 0;
}

fn clamp(v: integer, lo: integer, hi: integer) -> integer {
    if v > hi { return hi; }
    if v < lo { return lo; }
    return v;
}

// --- helpers -------------------------------------------------------------------

// `n / 2^k` rounded to the nearest integer, ties away from zero.
fn round_shift(n: integer, k: integer) -> integer {
    if n < 0 { return 0 - ((0 - n + (1 << (k - 1))) >> k); }
    return (n + (1 << (k - 1))) >> k;
}

// `n / d` rounded toward minus infinity; zero when `d` is.
fn floor_div(n: integer, d: integer) -> integer {
    if d == 0 { return 0; }
    if (n - (n / d) * d) != 0 and (n < 0) != (d < 0) { return n / d - 1; }
    return n / d;
}

// A value's raw word, narrowed to its own width: a computed value may carry
// bits above it until it is stored.
fn word<T>(value: T) -> integer {
    return integer(value) - ((integer(value) >> value'length) << value'length);
}

// The number a two's-complement word of `width` bits holds.
fn sext_word(word: integer, width: integer) -> integer {
    if (word >> (width - 1)) == 1 { return word - (1 << width); }
    return word;
}

// The words of `value` in the format `[left..right]`.
fn ufixed_word(value: real, left: integer, right: integer) -> integer {
    let steps: real = value * real(1 << (0 - right));
    let largest: integer = (1 << (left - right + 1)) - 1;
    if steps <= 0.0 { return 0; }
    if steps >= real(largest) { return largest; }
    return integer(steps + 0.5);
}

fn sfixed_word(value: real, left: integer, right: integer) -> integer {
    let steps: real = value * real(1 << (0 - right));
    let largest: integer = (1 << (left - right)) - 1;
    let smallest: integer = 0 - (1 << (left - right));
    if steps >= real(largest) { return largest; }
    if steps <= real(smallest) { return smallest; }
    if steps < 0.0 { return 0 - integer(0.5 - steps); }
    return integer(steps + 0.5);
}
