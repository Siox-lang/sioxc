module std::numeric;

// Value-range-constrained integers (spec 3.26), modelled on VHDL's
// natural/positive subtypes and the C fixed-width names. A ranged integer
// stores in the smallest width covering its range (two's complement when
// the range dips below zero); a constant outside the range is a compile
// error, and dynamic range checking is a later simulation check.

pub type Byte = integer<0..255>;
pub type Short = integer<-32768..32767>;
pub type Int = integer<-2147483648..2147483647>;
pub type Long = integer<-9223372036854775808..9223372036854775807>;
pub type Natural = integer<0..9223372036854775807>;
pub type Positive = integer<1..9223372036854775807>;

// Address-width helper (SV's $clog2): the number of bits needed to index
// `n` items. Recursive; const-evaluates in width positions
// (`unsigned[clog2(DEPTH)]`).
pub fn clog2(n: integer) -> integer {
    if n <= 1 { return 0; }
    return 1 + clog2((n + 1) / 2);
}
