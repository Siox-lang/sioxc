module std::math;

use std::convert::From;

// Complex value over the reals (modelled on ieee.math_complex). Components
// are the kernel base type `real` (f64 in simulation).
pub struct Complex {
    pub re: real,
    pub im: real
}

impl Add<Complex, Complex> for Complex {
    fn add(self, rhs: Complex) -> Complex {
        return Complex { .re = self.re + rhs.re, .im = self.im + rhs.im };
    }
}

// `z + 3`: the trait's type argument names the rhs operand type (Rust style).
impl Add<integer, Complex> for Complex {
    fn add(self, rhs: integer) -> Complex {
        return Complex { .re = self.re + rhs, .im = self.im };
    }
}

// `10 + 5i`: a numeric left operand promotes into the Complex plane.
impl Add<Complex, Complex> for integer {
    fn add(self, rhs: Complex) -> Complex {
        return Complex { .re = self + rhs.re, .im = rhs.im };
    }
}

impl Sub<Complex, Complex> for Complex {
    fn sub(self, rhs: Complex) -> Complex {
        return Complex { .re = self.re - rhs.re, .im = self.im - rhs.im };
    }
}

// `Complex(10)`: an explicit conversion from the kernel integer.
impl From<integer> for Complex {
    fn from(v: integer) -> Complex {
        return Complex { .re = v, .im = 0 };
    }
}

// `5i` is a pure imaginary `Complex` (the `i` suffix, over a real magnitude);
// the `suffix` method builds the value and is inlined at the use site.
impl Suffix<"i", real> for Complex {
    fn suffix(v: real) -> Complex { return Complex { .re = 0, .im = v }; }
}

// Math functions, generic over the numeric types: `integer`, `real`,
// `signed`/`unsigned` and the fixed formats. A call inlines, so the body's
// operators are the argument type's own (`signed` compares signed). Pure
// `return`/`if` bodies: inlined in hardware, const-evaluated when arguments
// are constants, callable from testbenches. `abs`, `rem` and `mod` are
// functions here as in mathematics, not operators (VHDL makes them operators).
pub fn abs<T: Ord<T>>(v: T) -> T {
    if v < 0 { return -v; }
    return v;
}

pub fn min<T: Ord<T>>(a: T, b: T) -> T {
    if a < b { return a; }
    return b;
}

pub fn max<T: Ord<T>>(a: T, b: T) -> T {
    if a > b { return a; }
    return b;
}

// The remainder with the dividend's sign (VHDL `rem`, Rust `%`): `/`
// truncates toward zero. `rem(0 - 7, 2)` is -1.
pub fn rem<T: Div<T, T>>(a: T, m: T) -> T {
    return a - (a / m) * m;
}

// The remainder with the divisor's sign (VHDL `mod`). `mod(0 - 7, 2)` is 1.
pub fn mod<T: Ord<T>>(a: T, m: T) -> T {
    if rem(a, m) != 0 and (rem(a, m) < 0) != (m < 0) { return rem(a, m) + m; }
    return rem(a, m);
}

// Real math straight from the C math library (spec 3.27, `extern "C"`):
// `real` maps to `double`, and the native test executable links -lm.
extern "C" {
    pub fn sqrt(x: real) -> real;
    pub fn sin(x: real) -> real;
    pub fn cos(x: real) -> real;
    pub fn exp(x: real) -> real;
    pub fn log(x: real) -> real;
    pub fn pow(x: real, y: real) -> real;
    pub fn floor(x: real) -> real;
    pub fn ceil(x: real) -> real;
    pub fn round(x: real) -> real;
}

pub const PI: real = 3.141592653589793;
pub const E: real = 2.718281828459045;
