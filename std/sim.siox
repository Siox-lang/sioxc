module std::sim;

// Simulation time and frequency (spec Stage 11, modelled on VHDL's `time`
// physical type). The simulator's base tick is 1 fs (the VCD timescale).
//
// `wait`/`tick`/`run` stimulus control is built-in simulator syntax for now
// (spec Stage 11 allows this).

pub struct Time {
    fs: integer,
}

// Time-unit literal suffixes: `10ns` is a `Time`. The symbol parameterizes the
// `Suffix` trait; the `suffix` method builds the value (inlined at the use
// site), so the fs scale per unit lives here in std source.
impl Suffix<"fs", integer> for Time {
    fn suffix(v: integer) -> Time { return Time { .fs = v }; }
}
impl Suffix<"ps", integer> for Time {
    fn suffix(v: integer) -> Time { return Time { .fs = v * 1000 }; }
}
impl Suffix<"ns", integer> for Time {
    fn suffix(v: integer) -> Time { return Time { .fs = v * 1000000 }; }
}
impl Suffix<"us", integer> for Time {
    fn suffix(v: integer) -> Time { return Time { .fs = v * 1000000000 }; }
}
impl Suffix<"ms", integer> for Time {
    fn suffix(v: integer) -> Time { return Time { .fs = v * 1000000000000 }; }
}

pub struct Freq {
    hz: integer,
}

// Frequency literal suffixes: `100MHz` is a `Freq`.
impl Suffix<"Hz", integer> for Freq {
    fn suffix(v: integer) -> Freq { return Freq { .hz = v }; }
}
impl Suffix<"kHz", integer> for Freq {
    fn suffix(v: integer) -> Freq { return Freq { .hz = v * 1000 }; }
}
impl Suffix<"MHz", integer> for Freq {
    fn suffix(v: integer) -> Freq { return Freq { .hz = v * 1000000 }; }
}
impl Suffix<"GHz", integer> for Freq {
    fn suffix(v: integer) -> Freq { return Freq { .hz = v * 1000000000 }; }
}

// Raw femtosecond multipliers, for integer time arithmetic.
pub const FS: integer = 1;
pub const PS: integer = 1000;
pub const NS: integer = 1000000;
pub const US: integer = 1000000000;
pub const MS: integer = 1000000000000;
