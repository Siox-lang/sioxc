module std::sim;


// Simulation time and frequency (modelled on VHDL physical quantities). `time`
// is a nominal integer measured in femtoseconds; frequency is a nominal real
// measured in hertz.
//
// Timing in a testbench is the built-in `await`: `await 10ns;` advances
// simulation time, `await clk.rising();` waits for an edge, and `await cond;`
// waits until a condition holds. `stop()` halts the test as passed so far and
// `finish()` ends the simulation cleanly; both are runtime-provided.

pub struct time(integer);
attr lang for time = "time";

impl Eq<time> for time {
    fn eq(rhs: time) -> Bool { return self == rhs; }
}

impl Ord<time> for time {
    fn lt(rhs: time) -> Bool { return self < rhs; }
    fn le(rhs: time) -> Bool { return self <= rhs; }
}

// Time-unit literal suffixes: `10ns` is a `time`. The symbol parameterizes the
// `Suffix` trait; the `suffix` method builds the value (inlined at the use
// site), so the fs scale per unit lives here in std source.
impl Suffix<"fs", integer> for time {
    static fn suffix(v: integer) -> time { return time(v); }
}
impl Suffix<"ps", integer> for time {
    static fn suffix(v: integer) -> time { return time(v * 1000); }
}
impl Suffix<"ns", integer> for time {
    static fn suffix(v: integer) -> time { return time(v * 1000000); }
}
impl Suffix<"us", integer> for time {
    static fn suffix(v: integer) -> time { return time(v * 1000000000); }
}
impl Suffix<"ms", integer> for time {
    static fn suffix(v: integer) -> time { return time(v * 1000000000000); }
}
// Seconds: `1s` is 10^15 fs, so a `time` holds up to about 9223 s.
impl Suffix<"s", integer> for time {
    static fn suffix(v: integer) -> time { return time(v * 1000000000000000); }
}

pub struct frequency(real);

impl Eq<frequency> for frequency {
    fn eq(rhs: frequency) -> Bool { return self == rhs; }
}

impl Ord<frequency> for frequency {
    fn lt(rhs: frequency) -> Bool { return self < rhs; }
    fn le(rhs: frequency) -> Bool { return self <= rhs; }
}

// Frequency literal suffixes: `100MHz` is a real-backed `frequency`.
impl Suffix<"Hz", real> for frequency {
    static fn suffix(v: real) -> frequency { return frequency(v); }
}
impl Suffix<"kHz", real> for frequency {
    static fn suffix(v: real) -> frequency { return frequency(v * 1000.0); }
}
impl Suffix<"MHz", real> for frequency {
    static fn suffix(v: real) -> frequency { return frequency(v * 1000000.0); }
}
impl Suffix<"GHz", real> for frequency {
    static fn suffix(v: real) -> frequency { return frequency(v * 1000000000.0); }
}

// Raw femtosecond multipliers, for integer time arithmetic.
pub const FS: integer = 1;
pub const PS: integer = 1000;
pub const NS: integer = 1000000;
pub const US: integer = 1000000000;
pub const MS: integer = 1000000000000;
