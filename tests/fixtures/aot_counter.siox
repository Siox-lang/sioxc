module aot_counter;

// A sole structural-root design compiled to a plain object file. An external harness
// drives it through the exported `sx_*` ABI — the external simulator shape.
entity Counter {
    clk: Bit in,
    rst: Logic in,
    n: unsigned[8] out
}

impl Counter {
    let v: unsigned[8] = 0;
    process update {
        if clk.rising() {
            if rst == '1' {
                v = 0;
            } else {
                v = v + 1;
            }
        }
    }
    n = v;
}
