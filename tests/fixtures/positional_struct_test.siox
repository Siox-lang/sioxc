// Positional name-less struct locals in the native testbench harness.
// `{ 3, 4 }` binds to fields by declaration order; the
// explicit and typed-positional forms must still agree.
module positional_struct;

using std::bits::unsigned;

struct Pkt { a: unsigned[8], b: unsigned[8] }

#[test]
entity PositionalStructTest {}

impl PositionalStructTest {
    let p: Pkt = { 3, 4 };            // positional name-less
    let q: Pkt = { .a = 7, .b = 9 };  // explicit
    let r: Pkt = Pkt { 5, 6 };        // typed positional

    assert!(p.a == 3, "p.a");
    assert!(p.b == 4, "p.b");
    assert!(q.a == 7, "q.a");
    assert!(q.b == 9, "q.b");
    assert!(r.a == 5, "r.a");
    assert!(r.b == 6, "r.b");

    p = { 10, 11 };
    assert!(p.a == 10, "positional reassignment p.a");
    assert!(p.b == 11, "positional reassignment p.b");

    r = Pkt { 12, 13 };
    assert!(r.a == 12, "typed positional reassignment r.a");
    assert!(r.b == 13, "typed positional reassignment r.b");
}
